<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/ink"
        app:title="@string/settings_title"
        app:titleTextColor="@color/ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_reminders" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/remindersSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/reminders_switch"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/timeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/time_label"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/timeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dayBeforeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/day_before"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/permissionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hint"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_hint"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/permissionButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_button" />
            </LinearLayout>

            <Button
                android:id="@+id/checkButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/check_button" />

            <TextView
                android:id="@+id/checkResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_privacy" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/lockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/lock_switch"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/lockHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/lock_hint"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_link" />

            <TextView
                android:id="@+id/linkValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textIsSelectable="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/changeLinkButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/change_link" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_text"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
